---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Arnaud Hervy"
	description="Developer documentation, content architecture, and tooling."
>
	<main class="landing" id="main-content" tabindex="-1">
		<div class="content-column">
			<h1>Arnaud Hervy</h1>
			<p class="positioning">Developer documentation, content architecture, and tooling</p>
			<p class="introduction">
				I work on developer documentation and the systems around it, including information
				architecture, API and platform content, and documentation workflows. My work increasingly
				focuses on how developer content is structured, created, and maintained.
			</p>

			<nav class="profile-links" aria-label="Profile links">
				<a href="https://www.linkedin.com/in/arnaudhervy/">LinkedIn</a>
				<a href="https://github.com/ahervy">GitHub</a>
			</nav>
		</div>
	</main>
</BaseLayout>
